# =============================================================================
# MINI TASK PLANNER - COMPREHENSIVE API CONFIGURATION
# =============================================================================
# Copy this file to .env and add your API keys to enable real-time data fetching
# When API keys are not provided, the system will use intelligent fallbacks

# =============================================================================
# LLM CONFIGURATION (Required for core functionality)
# =============================================================================
# OpenAI API Key - Required for agent intelligence
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1200
LLM_TOP_P=1.0
LLM_PRESENCE_PENALTY=0.0
LLM_FREQUENCY_PENALTY=0.0
LLM_RETRIES=2
LLM_TIMEOUT_MS=20000

# =============================================================================
# FLIGHT APIS - For real-time flight search and pricing
# =============================================================================
# Amadeus Travel API - Free tier: 2000 requests/month
# Sign up at: https://developers.amadeus.com/
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# SkyScanner RapidAPI - Free tier: 100 requests/month  
# Sign up at: https://rapidapi.com/skyscanner/api/skyscanner-flight-search
SKYSCANNER_API_KEY=

# AviationStack - Free tier: 1000 requests/month
# Sign up at: https://aviationstack.com/
AVIATIONSTACK_API_KEY=

# FlightAPI.io - Free tier available
# Sign up at: https://flightapi.io/
FLIGHTAPI_KEY=

# =============================================================================
# HOTEL APIS - For real-time hotel search and booking
# =============================================================================
# Hotels4 RapidAPI - Free tier available
# Sign up at: https://rapidapi.com/apidojo/api/hotels4
HOTELS4_API_KEY=

# Booking.com API - Partner program required
# Apply at: https://www.booking.com/content/affiliates.html
BOOKING_COM_API_KEY=

# =============================================================================
# TRANSPORTATION APIS - For real-time routing and transit
# =============================================================================
# Google Maps API - $200 free credits monthly
# Sign up at: https://developers.google.com/maps
GOOGLE_MAPS_API_KEY=

# HERE Maps API - Free tier available
# Sign up at: https://developer.here.com/
HERE_API_KEY=

# Mapbox API - Free tier available
# Sign up at: https://www.mapbox.com/
MAPBOX_ACCESS_TOKEN=

# =============================================================================
# WEATHER APIS - For destination weather forecasts
# =============================================================================
# OpenWeatherMap - Free tier: 1000 calls/day
# Sign up at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# WeatherAPI - Free tier: 1 million calls/month
# Sign up at: https://www.weatherapi.com/
WEATHER_API_KEY=

# =============================================================================
# POINTS OF INTEREST & ATTRACTIONS
# =============================================================================
# OpenTripMap API - Free with registration
# Sign up at: https://opentripmap.io/product
OTM_API_KEY=

# Foursquare Places API - Free tier available
# Sign up at: https://developer.foursquare.com/
FOURSQUARE_API_KEY=

# Ticketmaster API - Free tier available
# Sign up at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# =============================================================================
# CURRENCY & LOCATION SERVICES
# =============================================================================
# ExchangeRate-API - Free tier: 2000 requests/month
# Sign up at: https://exchangerate-api.com/
EXCHANGERATE_API_KEY=

# IPInfo - Free tier: 50k requests/month
# Sign up at: https://ipinfo.io/
IPINFO_TOKEN=

# IPAPI - Free tier available
# Sign up at: https://ipapi.co/
IPAPI_KEY=

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
# Feature toggles
ENABLE_IP_LOCATION=false
USE_PUBLIC_OSRM=true
ENABLE_EVENTS=false
ENVIRONMENT=development
DEBUG=true

# API behavior settings
TOOL_TIMEOUT_MS=8000
TOOL_RETRIES=2
API_RATE_LIMIT=60
API_RATE_WINDOW=60

# =============================================================================
# SERVICE BASE URLS (Override only if needed)
# =============================================================================
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=mini-task-planner/0.1
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WORLDTIMEAPI_BASE_URL=https://worldtimeapi.org/api
EXCHANGERATE_BASE_URL=https://api.exchangerate.host
OSRM_BASE_URL=https://router.project-osrm.org
OTM_BASE_URL=https://api.opentripmap.com/0.1/en/places
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2
IPINFO_BASE_URL=https://ipinfo.io
IPAPI_BASE_URL=https://ipapi.co
OTM_DEFAULT_RADIUS=3000

# =============================================================================
# API PRIORITY SETUP GUIDE
# =============================================================================
# ESSENTIAL (for basic functionality):
# 1. OPENAI_API_KEY - Required for agent intelligence
# 2. OPENWEATHER_API_KEY - Weather forecasts
# 3. OTM_API_KEY - Tourist attractions

# RECOMMENDED (for enhanced data):
# 4. AMADEUS_API_KEY + SECRET - Comprehensive flight/hotel data
# 5. GOOGLE_MAPS_API_KEY - Accurate routing and places
# 6. EXCHANGERATE_API_KEY - Real-time currency conversion

# OPTIONAL (for specialized features):
# 7. SKYSCANNER_API_KEY - Flight price comparison
# 8. HOTELS4_API_KEY - Hotel booking options
# 9. FOURSQUARE_API_KEY - Local business recommendations

# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env in your project root
# 2. Add API keys for services you want to use
# 3. System automatically detects available keys
# 4. Missing keys trigger intelligent fallbacks
# 5. Free tiers are sufficient for development/testing
# 6. Monitor usage to avoid rate limits

# =============================================================================
# SECURITY REMINDER
# =============================================================================
# - Never commit .env with real keys to version control
# - Add .env to .gitignore
# - Rotate keys regularly
# - Monitor API usage dashboards
